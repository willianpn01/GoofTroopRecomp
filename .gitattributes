# Line-ending policy. See docs/ARCHITECTURE.md ("Line endings").
#
# Text files are stored and checked out with LF on every platform: the ROM
# validator, the code generator and the config files are hashed, and their
# output must not depend on the checkout.
* text=auto eol=lf

*.c     text eol=lf
*.h     text eol=lf
*.cpp   text eol=lf
*.hpp   text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.json  text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.txt   text eol=lf
*.md    text eol=lf

# Windows command scripts need CRLF to run reliably in cmd.exe.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# The vendored engine is checked out byte for byte, with no conversion:
# tools/generate_aot.py verifies a digest of its exact contents
# (external/snesrecomp.lock.json), and some of its files use CRLF.
external/snesrecomp/** -text

*.png binary
*.ttf binary
*.tga binary
